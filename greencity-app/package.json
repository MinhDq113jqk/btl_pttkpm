{
  "name": "greencity-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "test": "node --test tests/logic.test.js tests/assistant.test.js tests/staff.test.js tests/frontend-integration.test.js tests/runtime-config.test.js tests/markdown-links.test.js tests/operational-forms.test.js tests/parking-reconciliation.test.js tests/sad-completion.test.js tests/sad-extensions.test.js tests/review-regressions.test.js tests/review-r04.test.js tests/review-r05.test.js tests/review-r06.test.js",
    "test:ux": "node tests/desktop-ux.cjs",
    "test:assistant": "node tests/assistant-ux.cjs",
    "test:assistant:security": "npm run build && node tests/assistant-security.cjs",
    "test:staff": "node tests/staff-ux.cjs",
    "test:cleaning": "node tests/cleaning-ux.cjs && node tests/cleaning-manager-ux.cjs",
    "test:security": "node tests/security-ux.cjs && node tests/security-manager-ux.cjs",
    "test:parcel": "node tests/parcel-ux.cjs",
    "test:billing": "node tests/billing-ux.cjs",
    "test:review:r03": "node tests/review-r03-ux.cjs && node tests/parcel-ux.cjs && node tests/billing-ux.cjs",
    "test:payments": "node tests/payment-ux.cjs",
    "test:notifications": "node tests/notification-ux.cjs",
    "test:dashboard": "node tests/dashboard-ux.cjs",
    "test:resident": "node tests/resident-ux.cjs",
    "test:imports": "node tests/import-ux.cjs",
    "test:work-orders": "node tests/work-order-ux.cjs",
    "test:maintenance": "node tests/maintenance-ux.cjs",
    "test:golden-flows": "node tests/golden-flows.cjs",
    "check:links": "node scripts/check-markdown-links.mjs",
    "check:source": "node scripts/check-source-hygiene.mjs",
    "test:review:r04": "node tests/review-r04-ux.cjs && node tests/payment-ux.cjs && node tests/notification-ux.cjs && node tests/import-ux.cjs",
    "test:review:r05": "node tests/review-r05-ux.cjs",
    "test:review:r06": "node tests/review-r06-sources-ux.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "marked": "17.0.5",
    "playwright": "1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
