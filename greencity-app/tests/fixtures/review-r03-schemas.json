    {
      "kind": "ORGANIZATION",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 80,
            "minLength": 3,
            "title": "Code",
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "valid_from": {
            "format": "date",
            "title": "Valid From",
            "type": "string"
          },
          "valid_to": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Valid To"
          },
          "body": {
            "maxLength": 4000,
            "minLength": 3,
            "title": "Body",
            "type": "string"
          },
          "confirmed_rule_reference": {
            "maxLength": 300,
            "minLength": 3,
            "title": "Confirmed Rule Reference",
            "type": "string"
          },
          "legal_name": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Legal Name",
            "type": "string"
          },
          "address": {
            "maxLength": 300,
            "minLength": 3,
            "title": "Address",
            "type": "string"
          },
          "representative_account_id": {
            "format": "uuid",
            "title": "Representative Account Id",
            "type": "string"
          },
          "contact": {
            "maxLength": 300,
            "minLength": 3,
            "title": "Contact",
            "type": "string"
          }
        },
        "required": [
          "code",
          "revision",
          "valid_from",
          "body",
          "confirmed_rule_reference",
          "legal_name",
          "address",
          "representative_account_id",
          "contact"
        ],
        "title": "OrganizationData",
        "type": "object"
      }
    },
    {
