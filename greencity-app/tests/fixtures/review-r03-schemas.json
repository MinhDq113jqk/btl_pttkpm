            "maxLength": 300,
            "minLength": 3,
            "title": "Evidence Reference",
            "type": "string"
          }
        },
        "required": [
          "name",
          "address",
          "evidence_reference"
        ],
        "title": "SiteProfileData",
        "type": "object"
      }
    },
    {
      "kind": "FEE_PUBLICATION",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "fee_version_id": {
            "format": "uuid",
            "title": "Fee Version Id",
            "type": "string"
          },
          "evidence_reference": {
            "maxLength": 300,
            "minLength": 3,
            "title": "Evidence Reference",
            "type": "string"
          }
        },
        "required": [
          "fee_version_id",
          "evidence_reference"
        ],
        "title": "FeePublicationData",
        "type": "object"
      }
    },
    {
      "kind": "FEE_BENEFIT",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "fee_policy_id": {
            "format": "uuid",
            "title": "Fee Policy Id",
            "type": "string"
          },
          "unit_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Unit Ids",
            "type": "array"
          },
          "valid_from": {
            "format": "date",
            "title": "Valid From",
            "type": "string"
          },
          "valid_to": {
            "format": "date",
            "title": "Valid To",
            "type": "string"
          },
          "percent": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 100.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,3}|(?=[\\d.]{1,8}0*$)\\d{0,3}\\.\\d{0,4}0*$)",
                "type": "string"
              }
            ],
            "title": "Percent"
          },
          "evidence_reference": {
            "maxLength": 300,
            "minLength": 3,
            "title": "Evidence Reference",
            "type": "string"
          }
        },
        "required": [
          "fee_policy_id",
          "unit_ids",
          "valid_from",
          "valid_to",
          "percent",
          "evidence_reference"
        ],
        "title": "BenefitData",
        "type": "object"
      }
    }
  ],
