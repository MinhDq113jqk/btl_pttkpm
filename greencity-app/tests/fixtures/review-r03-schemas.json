    },
    {
      "kind": "BUILDING_PROFILE",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "enum": [
              "CREATE",
              "UPDATE",
              "ACTIVATE",
              "DEACTIVATE"
            ],
            "title": "Operation",
            "type": "string"
          },
          "code": {
            "maxLength": 50,
            "minLength": 2,
            "pattern": "^[A-Z0-9][A-Z0-9_-]*$",
            "title": "Code",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "floors_count": {
            "maximum": 300,
            "minimum": 1,
            "title": "Floors Count",
            "type": "integer"
          },
          "zone_id": {
            "format": "uuid",
            "title": "Zone Id",
            "type": "string"
          },
          "evidence_reference": {
            "maxLength": 300,
            "minLength": 3,
            "title": "Evidence Reference",
            "type": "string"
          }
        },
        "required": [
          "operation",
          "code",
          "name",
          "floors_count",
          "zone_id",
          "evidence_reference"
        ],
        "title": "BuildingProfileData",
        "type": "object"
      }
    },
    {
      "kind": "SITE_PROFILE",
      "schema": {
        "additionalProperties": false,
