# Project reference documents are published to btl_pttkpm only.
documents/*
!documents/
!documents/greencity-project/
!documents/greencity-project/**

# Microsoft Office temporary files
~$*

# Operating-system files
Thumbs.db
.DS_Store

# Local credentials (including the supplied resource documents)
.env
.env.*
!.env.example
!.env.pilot.example
Tài_nguyên.md
Tài_nguyên.txt
*.pem
*.key

# Python backend outputs
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-temp*/
.test-runtime/
.private-evidence/
.review/
.coverage
htmlcov/
*.log

# Reproducible deployment manifests are source-controlled; local secret values
# under deploy/secrets remain ignored by their explicit filenames.
!deploy/
!deploy/**
deploy/**/__pycache__/
deploy/**/*.py[cod]
deploy/secrets/*
!deploy/secrets/README.txt

# Keep ad-hoc Markdown files out; the published bundle is explicitly included below.
*.md
!documents/greencity-project/
!documents/greencity-project/**

# Raw GreenCity datasets are local-only and may contain personal data.
documents/greencity-project/excel-data/
documents/greencity-project/data_that/

# Source checksums are local metadata for restricted real workbooks.
documents/greencity-project/DATA_SOURCE_MANIFEST.json

# Outputs derived from restricted raw data stay local, including failed staging.
**/local_validation_pack/
**/local_validation_manifest.json
**/approved_pack/
**/approved_manifest.json
**/.approved_pack_tmp_*/

# Local work files and submission-data reports may contain row-level metadata.
.local/
