# Public pilot template only. Keep real values in backend/.env or process env.
# The preflight rejects these placeholders; do not commit a filled copy.
DATABASE_URL=postgresql://pilot_user:CHANGE_ME@127.0.0.1:5432/greencity?sslmode=require
SECRET_KEY=CHANGE_ME_generate_a_random_key_with_at_least_32_bytes
APP_ENV=development
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
ATTACHMENT_LINK_TTL_SECONDS=60
# Set this only when the database provider requires a CA certificate.
# DATABASE_SSL_ROOT_CERT=C:/private/certs/ca.pem
