DATABASE_URL=your_postgresql_connection_string
GEMINI_API_KEY=your_gemini_api_key
SECRET_KEY=your_jwt_secret
# Required by HTTP app: replace placeholder with a private random key (>=32 bytes).
# No default key is accepted. Migration/probe commands do not require this key.
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Production requires verify-full and the Aiven project CA certificate.
# DATABASE_SSL_ROOT_CERT=C:/private/certs/ca.pem
