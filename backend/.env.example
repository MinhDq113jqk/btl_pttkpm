DATABASE_URL=your_postgresql_connection_string
# Server-only credential. The backend Gemini client reads this value only from
# backend/.env; never put it in greencity-app/.env or expose it as VITE_*.
# Keep the provider disabled until quota, budget, and retention controls are approved.
GEMINI_API_KEY=replace_with_server_side_gemini_key
ASSISTANT_ENABLED=false
SECRET_KEY=your_jwt_secret
# Required by HTTP app: replace placeholder with a private random key (>=32 bytes).
# No default key is accepted. Migration/probe commands do not require this key.
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
ATTACHMENT_LINK_TTL_SECONDS=60
# Temporary OR-07 baseline: 5 failures, 60-second first cooldown, 30-minute
# maximum, reset after 24 hours, and 30-day opaque identity-state retention.
LOGIN_THROTTLE_FAILURE_THRESHOLD=5
LOGIN_THROTTLE_BASE_BACKOFF_SECONDS=60
LOGIN_THROTTLE_MAX_BACKOFF_SECONDS=1800
LOGIN_THROTTLE_RESET_SECONDS=86400
LOGIN_THROTTLE_RETENTION_DAYS=30
LOGIN_THROTTLE_MAX_IDENTITIES=10000
# Demo seed is disabled by default and is never permitted in production. If a
# disposable development/test database needs it, set this flag and supply a
# JSON object containing one distinct >=16-byte credential for every configured
# demo username through a local secret store or process environment. Do not put
# credential values in this file, source control, terminal output, or runbooks.
DEMO_SEED_ENABLED=false
# DEMO_SEED_CREDENTIALS_JSON=
# Production requires verify-full and the Aiven project CA certificate.
# DATABASE_SSL_ROOT_CERT=C:/private/certs/ca.pem

# Resident portal: provider credentials belong in a private secret store.
VNPAY_ENABLED=false
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_SERVER_IP=127.0.0.1
VNPAY_RETURN_URL=http://localhost:8000/api/v1/portal/payments/vnpay/return
PORTAL_PUBLIC_URL=http://localhost:3000
VNPAY_INTENT_TTL_SECONDS=900
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_TENANT_ID=
# VNPAY_SERVICE_ACCOUNT_ID=
SMTP_ENABLED=false
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15
# SMTP_HOST=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
RECOVERY_TOKEN_TTL_SECONDS=900
BOOKING_HOLD_SECONDS=1800
